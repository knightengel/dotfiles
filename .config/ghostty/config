# ─────────────────────────────────────────────────────────────
# GHOSTTY 1.3.1 — ICE MOUNTAIN / macOS
# Под палитру твоих обоев: синий, ледяной голубой, снежный белый
# Без titlebar-иконок, без подписей окна, без scrollbar
# ─────────────────────────────────────────────────────────────

# Шрифт
font-family = JetBrains Mono
font-size = 14.5
font-feature = -calt,-liga,-dlig

# Окно
window-width = 120
window-height = 34
window-padding-x = 18
window-padding-y = 14
window-padding-balance = true
window-padding-color = background
window-vsync = true
window-save-state = always

# Полностью убираем titlebar / кнопки / подписи окна
window-decoration = none

# Основные цвета — под твои обои
background = #04131f
foreground = #d8f4ff

cursor-color = #84dcff
cursor-text = #04131f
cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.92

selection-background = #154861
selection-foreground = #eefbff

search-background = #4dcfff
search-foreground = #04131f
search-selected-background = #bdeeff
search-selected-foreground = #04131f

# Прозрачность / стекло
background-opacity = 0.74
background-opacity-cells = true
background-blur = 28

# ANSI palette — холодная, в тон обоям
palette = 0=#04111d
palette = 1=#b86f84
palette = 2=#79cbbd
palette = 3=#d9cb93
palette = 4=#2c92c8
palette = 5=#94a9dd
palette = 6=#6dcbe8
palette = 7=#d3f0fb
palette = 8=#12384f
palette = 9=#d98aa0
palette = 10=#9fe0d4
palette = 11=#ece3b1
palette = 12=#62bee9
palette = 13=#b4c5f3
palette = 14=#9fe7f7
palette = 15=#f5fcff

# Мышь / скролл / ссылки
mouse-hide-while-typing = true
scrollback-limit = 200000000
scrollbar = never
link-url = true
link-previews = true
copy-on-select = clipboard

# Сплиты
unfocused-split-opacity = 0.84
unfocused-split-fill = #04131f
split-divider-color = #2f96c9
split-preserve-zoom = navigation

# Shell integration
shell-integration = detect
shell-integration-features = no-cursor,sudo,ssh-env,ssh-terminfo,no-title,path

# Уведомления
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 15s

# Буфер обмена / безопасность
clipboard-read = ask
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
title-report = false

# Закрытие
confirm-close-surface = true
quit-after-last-window-closed = false

# Полезные бинды
keybind = cmd+shift+r=reload_config
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+z=toggle_split_zoom
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:down
keybind = cmd+alt+k=goto_split:up
keybind = cmd+alt+l=goto_split:right
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size
keybind = cmd+f=start_search
keybind = cmd+shift+c=copy_to_clipboard
keybind = cmd+shift+v=paste_from_clipboard
keybind = cmd+shift+backspace=clear_screen
